        "vendor": "Algonquin Hardware",
        "invoice_date": "2026-06-11",
        "invoice_number": "AH-3007",
        "printed_subtotal": 483.30, "printed_hst": 62.83, "printed_total": 546.13,
        "totals_mismatch": false,
        "lines": [
