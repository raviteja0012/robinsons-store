{
  "note": "Synthetic invoices only. Every vendor, address and number here is made up, and every phone number is in the 555-0100 to 555-0199 range reserved for fiction. Never paste a real invoice or real store data into this file.",
  "cases": [
    {
      "id": "extract-clean",
      "covers": "Normal path: a printed invoice, four lines, a company suffix on the vendor, and Subtotal, HST and Total rows that must not come back as purchases (capture adds HST on top of the line subtotal, so a tax row read as a line counts the tax twice). The invoice number and the three printed totals are copied as printed, and the lines make the printed subtotal.",
      "document": {
        "header": [
          { "bold": "NORTHBAY HARDWARE SUPPLY LTD." },
          "Unit 4, 88 Industrial Rd, North Bay ON   Tel 705-555-0110",
          "",
          { "bold": "INVOICE NB-20417" },
          "Invoice date: 2026-05-14",
          "Bill to: Lakeside general store",
          "Terms: Net 30"
        ],
        "table": {
          "columns": ["QTY", "DESCRIPTION", "UNIT PRICE", "AMOUNT"],
          "rows": [
            [4, "Manila rope 1/2 in x 50 ft", 18.75],
            [12, "Galvanized deck screws #8 x 2-1/2 in", 9.40],
            [2, "Steel garden rake, 16 tooth", 21.95],
            [6, "Exterior latex paint, white, 3.78 L", 38.60]
          ]
        },
        "totals": { "subtotal": "Subtotal", "hst": "HST 13%", "total": "Total" }
      },
      "expect": {
        "vendor": "Northbay Hardware Supply",
        "invoice_date": "2026-05-14",
        "invoice_number": "NB-20417",
        "printed_subtotal": 463.30, "printed_hst": 60.23, "printed_total": 523.53,
        "totals_mismatch": false,
        "lines": [
          { "match": ["manila", "rope"], "qty": 4, "unit_cost": 18.75, "retail_price_note": null },
          { "match": ["deck", "screws"], "qty": 12, "unit_cost": 9.40, "retail_price_note": null },
